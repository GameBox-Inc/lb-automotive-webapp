pipeline {
    agent any

    environment {
        // Git repository
        GIT_REPO = 'git@github.com:GameBox-Inc/lb-automotive-webapp.git'
        GIT_BRANCH = 'release/v0.1'
        
        // GitHub Container Registry
        REGISTRY = 'ghcr.io'
        GITHUB_ORG = 'gamebox-inc'
        BACKEND_IMAGE = "${REGISTRY}/${GITHUB_ORG}/lb-automotive-backend"
        FRONTEND_IMAGE = "${REGISTRY}/${GITHUB_ORG}/lb-automotive-frontend"
        
        // GitHub credentials for pushing manifest updates
        GITHUB_CREDENTIALS = 'github-ssh-key'

        // Python and Node versions
        PYTHON_VERSION = '3.11'
        NODE_VERSION = '18'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        skipDefaultCheckout()
    }

    stages {
        stage('Checkout') {
            steps {
                echo '📥 Checking out code...'
                script {
                    // Clean workspace and clone
                    sh '''
                        rm -rf .git * .*git* 2>/dev/null || true
                        git clone ${GIT_REPO} .
                        git checkout ${GIT_BRANCH}
                        git log -1 --oneline
                    '''
                    
                    env.GIT_COMMIT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT}"
                    
                    echo "Building version: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Backend Tests') {
            steps {
                echo '🧪 Running backend tests...'
                dir('python-backend') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements.txt
                        pip install pytest pytest-asyncio httpx
                        
                        # Run tests if they exist
                        if [ -d "tests" ]; then
                            pytest tests/ -v || echo "Some tests failed but continuing..."
                        else
                            echo "No tests found, skipping..."
                        fi
                    '''
                }
            }
        }

        stage('Frontend Tests') {
            steps {
                echo '🧪 Running frontend tests...'
                dir('frontend') {
                    sh '''
                        npm ci
                        npm run lint || echo "Linting issues found but continuing..."
                        # npm run test || echo "Tests failed but continuing..."
                    '''
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                echo '🐳 Building Docker images...'
                script {
                    // Build backend
                    sh """
                        docker build -t ${BACKEND_IMAGE}:${IMAGE_TAG} -f deployment/docker/Dockerfile.backend .
                        docker tag ${BACKEND_IMAGE}:${IMAGE_TAG} ${BACKEND_IMAGE}:latest
                    """
                    
                    // Build frontend
                    sh """
                        docker build -t ${FRONTEND_IMAGE}:${IMAGE_TAG} -f deployment/docker/Dockerfile.frontend .
                        docker tag ${FRONTEND_IMAGE}:${IMAGE_TAG} ${FRONTEND_IMAGE}:latest
                    """
                }
            }
        }

        stage('Push Images to Registry') {
            steps {
                echo '📤 Pushing images to GHCR...'
                script {
                    // Login to GHCR
                    withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                        sh '''
                            echo "$GITHUB_TOKEN" | docker login ghcr.io -u gamebox-inc --password-stdin
                        '''
                    }
                    
                    // Push images
                    sh """
                        docker push ${BACKEND_IMAGE}:${IMAGE_TAG}
                        docker push ${BACKEND_IMAGE}:latest
                        docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
                        docker push ${FRONTEND_IMAGE}:latest
                    """
                }
            }
        }

        stage('Update K8s Manifests') {
            steps {
                echo '📝 Updating Kubernetes manifests...'
                script {
                    // Update backend manifest
                    sh """
                        sed -i 's|image: ${BACKEND_IMAGE}:.*|image: ${BACKEND_IMAGE}:${IMAGE_TAG}|' deployment/k8s/backend.yaml
                    """
                    
                    // Update frontend manifest
                    sh """
                        sed -i 's|image: ${FRONTEND_IMAGE}:.*|image: ${FRONTEND_IMAGE}:${IMAGE_TAG}|' deployment/k8s/frontend.yaml
                    """
                    
                    // Show changes
                    sh 'git diff deployment/k8s/'
                }
            }
        }

        stage('Commit & Push Manifests') {
            steps {
                echo '🚀 Committing manifest changes (triggers ArgoCD)...'
                sshagent([GITHUB_CREDENTIALS]) {
                    sh """
                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@lb-automotive.local"
                        
                        git add deployment/k8s/backend.yaml deployment/k8s/frontend.yaml
                        
                        git commit -m "🚀 Deploy: Update images to ${IMAGE_TAG}

Build: #${BUILD_NUMBER}
Commit: ${GIT_COMMIT}
Triggered by: ${BUILD_USER:-Jenkins}
" || echo "No changes to commit"
                        
                        git push origin ${GIT_BRANCH}
                    """
                }
            }
        }

        stage('Notify ArgoCD') {
            steps {
                echo '🔄 ArgoCD will automatically detect and sync changes...'
                echo """
                ========================================
                📊 Build Summary
                ========================================
                Images Built:
                  Backend:  ${BACKEND_IMAGE}:${IMAGE_TAG}
                  Frontend: ${FRONTEND_IMAGE}:${IMAGE_TAG}
                
                Manifests Updated:
                  deployment/k8s/backend.yaml
                  deployment/k8s/frontend.yaml
                
                ArgoCD will deploy automatically.
                Monitor: https://argocd.yourdomain.com
                ========================================
                """
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completed successfully!'
            echo 'ArgoCD will deploy the new version automatically.'
        }

        failure {
            echo '❌ Pipeline failed! Check logs for details.'
        }

        cleanup {
            echo '🧹 Cleaning up Docker images...'
            sh """
                docker rmi ${BACKEND_IMAGE}:${IMAGE_TAG} || true
                docker rmi ${FRONTEND_IMAGE}:${IMAGE_TAG} || true
            """
        }
    }
}
