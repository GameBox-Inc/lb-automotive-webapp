# LB Automotive Dashboard - Production Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: JWT Secret Key
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# REQUIRED: Allowed CORS Origins (comma-separated)
# Add your production domain(s)
ALLOWED_ORIGINS=https://kozytherocket.space,https://www.kozytherocket.space

# LLM Configuration
# Choose 'ollama' for local LLM or 'anthropic' for Claude API
LLM_PROVIDER=ollama

# Anthropic Configuration (only if LLM_PROVIDER=anthropic)
# Get your API key from: https://console.anthropic.com/
#ANTHROPIC_API_KEY=sk-ant-xxxxx
#ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama Configuration (only if LLM_PROVIDER=ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=smollm2:135m

# Twilio Configuration (for IVR phone system)
# Get these from: https://console.twilio.com/
#TWILIO_ACCOUNT_SID=ACxxxxx
#TWILIO_AUTH_TOKEN=xxxxx
#TWILIO_PHONE_NUMBER=+1234567890

# Database (managed by Docker volume, usually don't need to change)
#DATABASE_URL=sqlite:////app/data/lb_automotive.db

# Redis (managed by Docker, usually don't need to change)
#REDIS_URL=redis://redis:6379/0

# Content Security Policy
# Use 'strict' for production, 'development' for testing
#CSP_POLICY=strict
