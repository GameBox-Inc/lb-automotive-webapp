# Stage 1: Build the React application
FROM node:18-alpine AS build

WORKDIR /app

# Copy package.json and lock files
COPY frontend/package.json ./
# Note: Assuming package-lock.json exists, if not it will skip. Copied just in case.
# COPY frontend/package-lock.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY frontend/ .

# Accept build argument for API URL
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

# Build the app
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Copy built assets from builder stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
# Use nginx-k8s.conf for Kubernetes (uses 'backend' service name)
# Use nginx-https.conf for Docker Compose (uses 'lb-auto-backend' service name)
COPY deployment/docker/nginx-k8s.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
