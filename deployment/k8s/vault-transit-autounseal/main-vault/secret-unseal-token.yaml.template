# =============================================================================
# secret-unseal-token.yaml.template
#
# Template for the K8s Secret that stores the Unseal Vault transit token.
# This secret is consumed by the Main Vault pod via env var injection.
#
# DO NOT commit with real values. Fill in the token from
# bootstrap_unseal_vault.sh output (main_vault_unseal_token.txt)
# and apply with:
#   envsubst < secret-unseal-token.yaml.template | kubectl apply -f -
# OR
#   kubectl create secret generic vault-transit-token \
#     --from-literal=token=<token> \
#     --namespace=gamebox-security
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: vault-transit-token
  namespace: gamebox-security
  labels:
    app: vault
    purpose: transit-autounseal
type: Opaque
stringData:
  token: "${MAIN_VAULT_UNSEAL_TOKEN}"
