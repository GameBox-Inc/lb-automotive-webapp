# Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./lb_automotive.db

# JWT Secret (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-generate-a-secure-random-string

# Twilio (Optional - only needed for IVR functionality)
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# LLM Provider Configuration
# Choose one: 'ollama' (local) or 'anthropic' (Claude API)
LLM_PROVIDER=ollama

# Ollama LLM (for local/self-hosted)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=smollm2:135m

# Anthropic Claude API (for cloud-based)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379/0

# Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma-separated) - REQUIRED, no default
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Content Security Policy mode: 'strict' or 'development'
# strict: No unsafe-inline/unsafe-eval (requires nonces for inline scripts)
# development: Allows unsafe-inline for Vite HMR
CSP_POLICY=development
