# LB Automotive Backend — Environment Variable Template
# Copy this file to .env and fill in all values before running.
# -----------------------------------------------------------
# SECURITY: .env must NOT be committed to version control.
# Generate each secret with: openssl rand -hex 32

# =============================================
# CRITICAL: JWT Secret Key
# =============================================
# CRIT-1: Generate a strong key before deployment.
# Run:  openssl rand -hex 32
# Then copy the output here and inject it via K8s secret in production.
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================
# Application Environment
# =============================================
# Controls: Swagger UI visibility, CORS warnings, Twilio validation
# Values: development | production
# WARNING: Never set to "development" in production deployments.
ENVIRONMENT=development

# =============================================
# CAPTCHA Enforcement
# =============================================
# CRIT-2: Set to "true" in production. Only set "false" in local dev without Redis.
CAPTCHA_REQUIRED=true

# =============================================
# Rate Limiting
# =============================================
# MED-2: Default is 120 req/min per IP. Only increase for a specific justified reason.
RATE_LIMIT_PER_MINUTE=120

# =============================================
# Database
# =============================================
DATABASE_URL=sqlite:///./lb_automotive.db
# PostgreSQL: optional app role for RLS (see deployment docs)
# APP_DATABASE_URL=
# DATABASE_READ_URL=
# Connection pool (psycopg2 ThreadedConnectionPool); RLS session vars reset on every checkout.
# DB_POOL_ENABLED=true
# DB_POOL_MIN=1
# DB_POOL_MAX=20
# Startup: seed_data() runs only if RUN_SEED_ON_STARTUP=true OR ENVIRONMENT is development|test.
# Production pods skip seed by default; use Supabase migrations / Jenkins for schema and seeds.
# RUN_SEED_ON_STARTUP=false

# =============================================
# CORS — Allowed Origins
# =============================================
# MED-8: Comma-separated list of allowed origins.
# WARNING: Do not include ngrok or localhost origins in production.
ALLOWED_ORIGINS=http://localhost:5173,http://10.100.0.1

# =============================================
# Redis
# =============================================
REDIS_URL=redis://localhost:6379

# =============================================
# Twilio
# =============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+15550000000

# MED-3: Webhook callback URL. Set this to your public HTTPS Twilio-accessible URL.
TWILIO_WEBHOOK_BASE_URL=https://twilio.kozytherocket.space/lb-automotive/api/twilio/webhook

# Optional: ElevenLabs TTS for IVR (<Play> MP3) — see docs/runbooks/ivr-elevenlabs.md
# ELEVENLABS_API_KEY=
# Public HTTPS base Twilio can reach for GET /api/twilio/tts-audio/{id} (defaults from TWILIO_WEBHOOK_BASE_URL if unset)
# IVR_TTS_PUBLIC_BASE_URL=https://twilio.kozytherocket.space/lb-automotive
# ELEVENLABS_TIMEOUT_SECONDS=12
# IVR_TTS_CB_FAILURE_THRESHOLD=5
# IVR_TTS_CB_WINDOW_SECONDS=60
# IVR_TTS_CB_OPEN_SECONDS=120

# Cap concurrent LLM intent classification tasks per backend process (IVR).
# IVR_LLM_CONCURRENCY_LIMIT=4

# MED-4: ONLY set TWILIO_SKIP_VALIDATION=true in local dev when you have no real Twilio traffic.
# NEVER set this in production — it disables HMAC signature verification.
# TWILIO_SKIP_VALIDATION=true

# =============================================
# Jenkins CI/CD Integration
# =============================================
JENKINS_URL=http://your-jenkins-server:8080
JENKINS_USER=your-jenkins-username
JENKINS_TOKEN=CHANGE_ME
